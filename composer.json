{
  "name": "stacknuts/magento-stackgauge-security",
  "description": "Security-posture checks (admin hygiene, config hygiene, filesystem exposure, webshell/tamper heuristics) for StackNuts StackGauge, split out so sites that already have dedicated security scanning aren't paying its cost for nothing.",
  "type": "magento2-module",
  "keywords": ["magento2", "security", "stackgauge", "webshell", "malware-scanning"],
  "homepage": "https://github.com/StackNuts/magento-stackgauge-security",
  "authors": [
    {
      "name": "Phil Rowe",
      "email": "stack.nuts@outlook.com"
    }
  ],
  "support": {
    "issues": "https://github.com/StackNuts/magento-stackgauge-security/issues",
    "source": "https://github.com/StackNuts/magento-stackgauge-security"
  },
  "license": "proprietary",
  "require": {
    "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
    "stacknuts/magento-stackgauge": ">=0.3.3 <1.0",
    "magento/framework": ">=103.0 <104",
    "magento/module-user": ">=101.2 <102",
    "magento/module-cms": ">=104.0 <105"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "StackNuts\\StackGaugeSecurity\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StackNuts\\StackGaugeSecurity\\Test\\": "Test/"
    }
  }
}
